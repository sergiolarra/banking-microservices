              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F2-AC1: 201 DEPOSIT, balance 2600.00', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const movement = pm.response.json();",
                  "    pm.expect(movement.movementType).to.eql('DEPOSIT');",
                  "    pm.expect(movement.balance).to.eql(2600.00);",
                  "    pm.collectionVariables.set('depositId', movement.id);",
                  "});"
