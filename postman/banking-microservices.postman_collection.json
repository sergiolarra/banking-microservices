{
  "info": {
    "_postman_id": "daaa07a3-51fa-5e53-ae45-18e04e050d22",
    "name": "banking-microservices",
    "description": "End-to-end checks of F1-F4 against both services (SPEC §5). Run in order, e.g. `npx newman run postman/banking-microservices.postman_collection.json -e postman/local.postman_environment.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
