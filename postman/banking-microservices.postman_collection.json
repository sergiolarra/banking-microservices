                  "    pm.response.to.have.status(422);",
                  "    pm.expect(pm.response.json().code).to.eql('BUSINESS_RULE_VIOLATION');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create client with invalid data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientsUrl}}/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"J\",\n  \"gender\": \"MALE\",\n  \"age\": 35,\n  \"identification\": \"1\",\n  \"address\": \"Otavalo sn\",\n  \"phone\": \"abc\",\n  \"password\": \"short\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 VALIDATION_ERROR with field errors (RFC 7807)', () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    const problem = pm.response.json();",
                  "    pm.expect(problem.code).to.eql('VALIDATION_ERROR');",
