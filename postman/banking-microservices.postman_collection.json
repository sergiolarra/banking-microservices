  "item": [
    {
      "name": "1. Clients (F1)",
      "description": "CRUD of clients on clients-service. Each run uses a new identification, so the collection can be run repeatedly.",
      "item": [
        {
          "name": "Create client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientsUrl}}/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jose Lema\",\n  \"gender\": \"MALE\",\n  \"age\": 35,\n  \"identification\": \"{{identification}}\",\n  \"address\": \"Otavalo sn y principal\",\n  \"phone\": \"098254785\",\n  \"password\": \"Clave1234\",\n  \"active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('identification', String(Date.now()).slice(-10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created with Location', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.headers.get('Location')).to.include('/clients/');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('F1-AC1: returns clientId and never the password', () => {",
                  "    pm.expect(body.clientId).to.be.a('string');",
                  "    pm.expect(body).to.not.have.property('password');",
                  "    pm.expect(body.active).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set('clientId', body.clientId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create client with the same identification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientsUrl}}/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jose Lema\",\n  \"gender\": \"MALE\",\n  \"age\": 35,\n  \"identification\": \"{{identification}}\",\n  \"address\": \"Otavalo sn y principal\",\n  \"phone\": \"098254785\",\n  \"password\": \"Clave1234\",\n  \"active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F1-AC2: 409 DUPLICATE_RESOURCE', () => {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().code).to.eql('DUPLICATE_RESOURCE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create underage client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientsUrl}}/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jose Lema\",\n  \"gender\": \"MALE\",\n  \"age\": 17,\n  \"identification\": \"{{underageIdentification}}\",\n  \"address\": \"Otavalo sn y principal\",\n  \"phone\": \"098254785\",\n  \"password\": \"Clave1234\",\n  \"active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
