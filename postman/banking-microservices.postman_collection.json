    {
      "name": "4. Account statement (F4)",
      "description": "GET /reports?date=from,to&client=clientId (ADR-028).",
      "item": [
        {
          "name": "Account statement",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsUrl}}/reports?date={{from}},{{to}}&client={{clientId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Yesterday to tomorrow (UTC) always contains today's movements, whatever the time zone",
                  "const day = 24 * 60 * 60 * 1000;",
                  "pm.collectionVariables.set('from', new Date(Date.now() - day).toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('to', new Date(Date.now() + day).toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F4-AC7: 200 application/json', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "const statement = pm.response.json();",
                  "const account = statement.accounts.find(a => a.accountNumber === pm.collectionVariables.get('accountNumber'));",
                  "const second = statement.accounts.find(a => a.accountNumber === pm.collectionVariables.get('secondAccountNumber'));",
                  "pm.test('F4-AC1: both accounts with balances and totals', () => {",
                  "    pm.expect(statement.client.clientId).to.eql(pm.collectionVariables.get('clientId'));",
                  "    pm.expect(statement.accounts).to.have.length(2);",
                  "    pm.expect(account.availableBalance).to.eql(2500.00);",
                  "    pm.expect(account.totalCredits).to.eql(600.00);",
                  "    pm.expect(account.totalDebits).to.eql(100.00);",
                  "});",
                  "pm.test('F4-AC2: movements oldest first', () => {",
                  "    pm.expect(account.movements.map(m => m.amount)).to.eql([600.00, -100.00]);",
                  "});",
                  "pm.test('F4-AC3: an account without movements has an empty list', () => {",
                  "    pm.expect(second.movements).to.eql([]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid date range",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsUrl}}/reports?date=2026-10-31,2026-10-01&client={{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F4-AC4: 400 INVALID_PARAMETER', () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().code).to.eql('INVALID_PARAMETER');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown client",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsUrl}}/reports?date=2026-10-01,2026-10-31&client=00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F4-AC5: 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Client deletion (ADR-016)",
      "description": "Deleting a client deactivates its accounts and keeps their history.",
      "item": [
        {
          "name": "Delete client",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{clientsUrl}}/clients/{{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F1-AC5: 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deleted client is gone",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{clientsUrl}}/clients/{{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Accounts of the deleted client are deactivated",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsUrl}}/accounts/{{accountNumber}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Waits one second before each retry (eventual consistency, SPEC §10)",
                  "const tries = Number(pm.collectionVariables.get('deactivationTries') || 0);",
                  "if (tries > 0) { setTimeout(() => {}, 1000); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// client.deleted travels asynchronously; retry until accounts-service applies it",
                  "const tries = Number(pm.collectionVariables.get('deactivationTries') || 0);",
                  "if (pm.response.json().active === true && tries < 15) {",
                  "    pm.collectionVariables.set('deactivationTries', tries + 1);",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "    return;",
                  "}",
                  "pm.collectionVariables.unset('deactivationTries');",
                  "pm.test('Account kept but inactive, balance preserved', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().active).to.eql(false);",
                  "    pm.expect(pm.response.json().availableBalance).to.eql(2500.00);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Statement of the deleted client is still available",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsUrl}}/reports?date={{from}},{{to}}&client={{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F4-AC5: 200, history kept', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().accounts).to.have.length(2);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
