                  "    const page = pm.response.json();",
                  "    pm.expect(page.content).to.be.an('array');",
                  "    pm.expect(page.size).to.eql(5);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace client (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientsUrl}}/clients/{{clientId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jose A. Lema\",\n  \"gender\": \"MALE\",\n  \"age\": 36,\n  \"identification\": \"{{identification}}\",\n  \"address\": \"Otavalo sn y principal\",\n  \"phone\": \"098254785\",\n  \"active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with the new data', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().name).to.eql('Jose A. Lema');",
                  "    pm.expect(pm.response.json().age).to.eql(36);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update client address (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientsUrl}}/clients/{{clientId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"Amazonas y NNUU\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 changing only the address', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().address).to.eql('Amazonas y NNUU');",
                  "    pm.expect(pm.response.json().name).to.eql('Jose A. Lema');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Accounts (F1)",
      "description": "Accounts on accounts-service. Creating the first account retries while the client event is on its way (eventual consistency, SPEC §10).",
      "item": [
        {
          "name": "Create account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountsUrl}}/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"accountType\": \"SAVINGS\",\n  \"initialBalance\": 2000.0,\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('accountTries')) {",
                  "    pm.collectionVariables.set('accountNumber', String(Math.floor(100000000 + Math.random() * 900000000)));",
                  "}",
                  "",
                  "// Waits one second before each retry (eventual consistency, SPEC §10)",
                  "const tries = Number(pm.collectionVariables.get('accountTries') || 0);",
                  "if (tries > 0) { setTimeout(() => {}, 1000); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// clients-service announces the client asynchronously; retry while it has not arrived yet",
                  "const tries = Number(pm.collectionVariables.get('accountTries') || 0);",
                  "if (pm.response.code === 422 && pm.response.json().code === 'CLIENT_UNAVAILABLE' && tries < 15) {",
                  "    pm.collectionVariables.set('accountTries', tries + 1);",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "    return;",
                  "}",
                  "pm.collectionVariables.unset('accountTries');",
                  "pm.test('201 Created, available balance = initial balance', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const account = pm.response.json();",
                  "    pm.expect(account.availableBalance).to.eql(2000.00);",
                  "    pm.expect(account.active).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create second account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountsUrl}}/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{secondAccountNumber}}\",\n  \"accountType\": \"CHECKING\",\n  \"initialBalance\": 100.0,\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('secondAccountNumber', String(Math.floor(1000000000 + Math.random() * 8999999999)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create account for an unknown client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountsUrl}}/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"123456\",\n  \"accountType\": \"SAVINGS\",\n  \"initialBalance\": 1,\n  \"clientId\": \"00000000-0000-0000-0000-000000000000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F1-AC6: 422 CLIENT_UNAVAILABLE', () => {",
                  "    pm.response.to.have.status(422);",
                  "    pm.expect(pm.response.json().code).to.eql('CLIENT_UNAVAILABLE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsUrl}}/accounts/{{accountNumber}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with balances', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().initialBalance).to.eql(2000.00);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List accounts of the client",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsUrl}}/accounts?clientId={{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with both accounts', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().totalElements).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Change account type (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountsUrl}}/accounts/{{secondAccountNumber}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountType\": \"SAVINGS\",\n  \"initialBalance\": 999\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F1-AC7: 200, type changes and balances do not', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().accountType).to.eql('SAVINGS');",
                  "    pm.expect(pm.response.json().initialBalance).to.eql(100.00);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete account is not allowed",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{accountsUrl}}/accounts/{{accountNumber}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F1-AC8: 405 METHOD_NOT_ALLOWED', () => {",
                  "    pm.response.to.have.status(405);",
                  "    pm.expect(pm.response.json().code).to.eql('METHOD_NOT_ALLOWED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Movements (F1, F2, F3)",
      "description": "Deposits are positive amounts and withdrawals negative ones (ADR-012).",
      "item": [
        {
          "name": "Deposit 600",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountsUrl}}/movements",
